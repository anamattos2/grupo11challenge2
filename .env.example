# Exemplo sem credenciais reais. Copie para .env, que é ignorado pelo Git.
# As ferramentas RAG serão implementadas em suas issues.
FINANCE_ENV=development
FINANCE_RUNTIME_DIR=.runtime
# Endereço local de referência; nenhum modelo é baixado automaticamente.
OLLAMA_BASE_URL=http://localhost:11434

# Backend financeiro. Valores fictícios, somente para uso local.
DJANGO_SECRET_KEY=troque-esta-chave-local
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# PostgreSQL local (infra/compose.yaml).
POSTGRES_DB=grupo11
POSTGRES_USER=grupo11
POSTGRES_PASSWORD=troque-esta-senha-local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Comprovantes por imagem (S5-01): pasta privada, limite em MB, retenção em horas e envios por hora
COMPROVANTES_DIR=.runtime/comprovantes
COMPROVANTES_TAMANHO_MAXIMO_MB=5
COMPROVANTES_RETENCAO_HORAS=72
COMPROVANTES_ENVIOS_POR_HORA=30
# Extração de campos (S5-02): motor tesseract ou desligado, idioma e tempo limite em segundos
COMPROVANTES_OCR_MOTOR=tesseract
COMPROVANTES_OCR_IDIOMA=por
COMPROVANTES_OCR_TEMPO_LIMITE_S=20
