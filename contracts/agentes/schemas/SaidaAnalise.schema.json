{
  "$defs": {
    "Afirmacao": {
      "additionalProperties": false,
      "description": "Uma frase verificável, sempre ligada a evidências.",
      "properties": {
        "evidencias_ids": {
          "items": {
            "pattern": "^(doc:[0-9a-f]{16,64}|fin:[a-z_]{3,40}:[0-9a-f]{12})$",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Evidencias Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^a[0-9]{1,3}$",
          "title": "Id",
          "type": "string"
        },
        "natureza": {
          "enum": [
            "dado_pessoal",
            "calculo",
            "orientacao_educativa"
          ],
          "title": "Natureza",
          "type": "string"
        },
        "texto": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Texto",
          "type": "string"
        }
      },
      "required": [
        "id",
        "texto",
        "natureza",
        "evidencias_ids"
      ],
      "title": "Afirmacao",
      "type": "object"
    },
    "Lacuna": {
      "additionalProperties": false,
      "description": "Informação que faltou para responder; vira pedido de complemento.",
      "properties": {
        "codigo": {
          "enum": [
            "periodo_nao_informado",
            "sem_dados_financeiros",
            "sem_categoria_essencial",
            "sem_fonte_documental",
            "pergunta_ambigua"
          ],
          "title": "Codigo",
          "type": "string"
        },
        "descricao": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Descricao",
          "type": "string"
        },
        "pergunta_complemento": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pergunta Complemento"
        }
      },
      "required": [
        "codigo",
        "descricao"
      ],
      "title": "Lacuna",
      "type": "object"
    }
  },
  "$id": "https://github.com/anamattos2/grupo11challenge2/contracts/agentes/schemas/SaidaAnalise.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "afirmacoes": {
      "items": {
        "$ref": "#/$defs/Afirmacao"
      },
      "title": "Afirmacoes",
      "type": "array"
    },
    "codigo_erro": {
      "anyOf": [
        {
          "pattern": "^[a-z_]{3,40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Codigo Erro"
    },
    "lacunas": {
      "items": {
        "$ref": "#/$defs/Lacuna"
      },
      "title": "Lacunas",
      "type": "array"
    },
    "status": {
      "enum": [
        "analisada",
        "dados_insuficientes",
        "falha"
      ],
      "title": "Status",
      "type": "string"
    },
    "versao": {
      "const": "1.0",
      "default": "1.0",
      "title": "Versao",
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "title": "SaidaAnalise",
  "type": "object",
  "x-versao-contrato": "1.0"
}
