{
  "$defs": {
    "Afirmacao": {
      "additionalProperties": false,
      "description": "Uma frase verificável, sempre ligada a evidências.",
      "properties": {
        "evidencias_ids": {
          "items": {
            "pattern": "^(doc:[0-9a-f]{16,64}|fin:[a-z_]{3,40}:[0-9a-f]{12})$",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Evidencias Ids",
          "type": "array"
        },
        "id": {
          "pattern": "^a[0-9]{1,3}$",
          "title": "Id",
          "type": "string"
        },
        "natureza": {
          "enum": [
            "dado_pessoal",
            "calculo",
            "orientacao_educativa"
          ],
          "title": "Natureza",
          "type": "string"
        },
        "texto": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Texto",
          "type": "string"
        }
      },
      "required": [
        "id",
        "texto",
        "natureza",
        "evidencias_ids"
      ],
      "title": "Afirmacao",
      "type": "object"
    },
    "Lacuna": {
      "additionalProperties": false,
      "description": "Informação que faltou para responder; vira pedido de complemento.",
      "properties": {
        "codigo": {
          "enum": [
            "periodo_nao_informado",
            "sem_dados_financeiros",
            "sem_categoria_essencial",
            "sem_fonte_documental",
            "pergunta_ambigua",
            "periodo_excedido",
            "dados_pessoais_sem_suporte"
          ],
          "title": "Codigo",
          "type": "string"
        },
        "descricao": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Descricao",
          "type": "string"
        },
        "pergunta_complemento": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pergunta Complemento"
        }
      },
      "required": [
        "codigo",
        "descricao"
      ],
      "title": "Lacuna",
      "type": "object"
    },
    "OperacaoFinanceira": {
      "description": "Lista fechada de consultas financeiras. Não há SQL livre nem escrita.",
      "enum": [
        "resumo_transacoes",
        "listar_contas",
        "situacao_reserva"
      ],
      "title": "OperacaoFinanceira",
      "type": "string"
    },
    "ParametrosFinanceiros": {
      "additionalProperties": false,
      "description": "Parâmetros que o planejador (regra ou LLM) pode preencher.\n\nRepare que não existe campo de usuária: quem é a dona dos dados vem do\n``ContextoAutorizado``, e ``extra=\"forbid\"`` recusa qualquer tentativa.",
      "properties": {
        "periodo_fim": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Periodo Fim"
        },
        "periodo_inicio": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Periodo Inicio"
        },
        "somente_essenciais": {
          "default": false,
          "title": "Somente Essenciais",
          "type": "boolean"
        },
        "tipo": {
          "anyOf": [
            {
              "enum": [
                "receita",
                "despesa"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tipo"
        }
      },
      "title": "ParametrosFinanceiros",
      "type": "object"
    },
    "PedidoCalculo": {
      "additionalProperties": false,
      "description": "A Analysis pede um número que ainda não está nas evidências.\n\nA Analysis não calcula valores oficiais (decisão D05): ela pede ao backend,\npela mesma lista fechada de operações da Research. O orquestrador\ntransforma o pedido em ``ChamadaFerramenta`` com ``pedido_id``, a Research\nexecuta e a Analysis recebe a pesquisa completada. Exemplo: a pergunta\ncompara outubro com setembro, mas a Research só trouxe outubro.",
      "properties": {
        "id": {
          "pattern": "^c[0-9]{1,2}$",
          "title": "Id",
          "type": "string"
        },
        "motivo": {
          "description": "Para que a Analysis precisa do resultado.",
          "maxLength": 300,
          "minLength": 1,
          "title": "Motivo",
          "type": "string"
        },
        "operacao": {
          "$ref": "#/$defs/OperacaoFinanceira"
        },
        "parametros": {
          "$ref": "#/$defs/ParametrosFinanceiros"
        }
      },
      "required": [
        "id",
        "operacao",
        "motivo"
      ],
      "title": "PedidoCalculo",
      "type": "object"
    }
  },
  "$id": "https://github.com/anamattos2/grupo11challenge2/contracts/agentes/schemas/SaidaAnalise.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "afirmacoes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Afirmacao"
      },
      "maxItems": 5,
      "title": "Afirmacoes",
      "type": "array"
    },
    "calculos": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PedidoCalculo"
      },
      "maxItems": 3,
      "title": "Calculos",
      "type": "array"
    },
    "codigo_erro": {
      "anyOf": [
        {
          "pattern": "^[a-z_]{3,40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Codigo Erro"
    },
    "lacunas": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Lacuna"
      },
      "title": "Lacunas",
      "type": "array"
    },
    "status": {
      "enum": [
        "analisada",
        "precisa_calculo",
        "dados_insuficientes",
        "falha"
      ],
      "title": "Status",
      "type": "string"
    },
    "versao": {
      "const": "1.0",
      "default": "1.0",
      "title": "Versao",
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "title": "SaidaAnalise",
  "type": "object",
  "x-versao-contrato": "1.0"
}
