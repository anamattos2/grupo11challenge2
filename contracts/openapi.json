                  "title": "Response",
                  "type": "array"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroOut"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "summary": "Listar Categorias",
        "tags": [
          "categorias"
        ]
      },
