{
  "components": {
    "schemas": {
      "ComprovanteOut": {
        "properties": {
          "altura": {
            "title": "Altura",
            "type": "integer"
          },
          "criado_em": {
            "format": "date-time",
            "title": "Criado Em",
            "type": "string"
          },
          "expira_em": {
            "format": "date-time",
            "title": "Expira Em",
            "type": "string"
          },
          "formato": {
            "title": "Formato",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "largura": {
            "title": "Largura",
            "type": "integer"
          },
          "tamanho_bytes": {
            "title": "Tamanho Bytes",
            "type": "integer"
          },
          "tipo_mime": {
            "title": "Tipo Mime",
            "type": "string"
          }
        },
        "required": [
          "id",
          "formato",
          "tipo_mime",
          "tamanho_bytes",
          "largura",
          "altura",
          "criado_em",
          "expira_em"
        ],
        "title": "ComprovanteOut",
        "type": "object"
      },
      "ContaIn": {
        "additionalProperties": false,
        "properties": {
          "nome": {
            "examples": [
              "Conta principal"
            ],
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Nome",
            "type": "string"
          },
          "saldo_declarado": {
            "description": "Valor informado pela usuária; não é saldo bancário verificado.",
            "examples": [
              "1500.50"
            ],
            "pattern": "^-?[0-9]{1,12}(\\.[0-9]{1,2})?$",
            "title": "Saldo Declarado",
            "type": "string"
          },
          "tipo": {
            "$ref": "#/components/schemas/Tipo"
          }
        },
        "required": [
          "nome",
          "tipo",
          "saldo_declarado"
        ],
        "title": "ContaIn",
        "type": "object"
      },
      "ContaOut": {
        "properties": {
          "atualizado_em": {
            "format": "date-time",
            "title": "Atualizado Em",
            "type": "string"
          },
          "criado_em": {
            "format": "date-time",
            "title": "Criado Em",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "moeda": {
            "title": "Moeda",
            "type": "string"
          },
          "nome": {
            "title": "Nome",
            "type": "string"
          },
          "saldo_declarado": {
            "examples": [
              "1500.50"
            ],
            "pattern": "^-?[0-9]{1,12}(\\.[0-9]{1,2})?$",
            "title": "Saldo Declarado",
            "type": "string"
          },
          "tipo": {
            "$ref": "#/components/schemas/Tipo"
          }
        },
        "required": [
          "id",
          "nome",
          "tipo",
          "saldo_declarado",
          "moeda",
          "criado_em",
          "atualizado_em"
        ],
        "title": "ContaOut",
        "type": "object"
      },
      "CredenciaisIn": {
        "properties": {
          "password": {
            "maxLength": 4096,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "username": {
            "maxLength": 150,
            "minLength": 1,
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "title": "CredenciaisIn",
        "type": "object"
      },
      "CsrfOut": {
        "properties": {
          "csrf_token": {
            "title": "Csrf Token",
            "type": "string"
          }
        },
        "required": [
          "csrf_token"
        ],
        "title": "CsrfOut",
        "type": "object"
      },
      "ErroOut": {
        "properties": {
          "codigo": {
            "title": "Codigo",
            "type": "string"
          },
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "codigo",
          "detail"
        ],
        "title": "ErroOut",
        "type": "object"
      },
      "ErroValidacaoOut": {
        "properties": {
          "detail": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErroValidacaoOut",
        "type": "object"
      },
      "HealthOut": {
        "properties": {
          "database": {
            "title": "Database",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "title": "HealthOut",
        "type": "object"
      },
      "PerfilIn": {
        "additionalProperties": false,
        "properties": {
          "nome_exibicao": {
            "examples": [
              "Clara Exemplo"
            ],
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$",
            "title": "Nome Exibicao",
            "type": "string"
          },
          "previsibilidade_renda": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PrevisibilidadeRenda"
              }
            ],
            "default": "nao_informada"
          }
        },
        "required": [
          "nome_exibicao"
        ],
        "title": "PerfilIn",
        "type": "object"
      },
      "PerfilOut": {
        "properties": {
          "atualizado_em": {
            "format": "date-time",
            "title": "Atualizado Em",
            "type": "string"
          },
          "criado_em": {
            "format": "date-time",
            "title": "Criado Em",
            "type": "string"
          },
          "nome_exibicao": {
            "title": "Nome Exibicao",
            "type": "string"
          },
          "previsibilidade_renda": {
            "$ref": "#/components/schemas/PrevisibilidadeRenda"
          }
        },
        "required": [
          "nome_exibicao",
          "previsibilidade_renda",
          "criado_em",
          "atualizado_em"
        ],
        "title": "PerfilOut",
        "type": "object"
      },
      "PrevisibilidadeRenda": {
        "enum": [
          "fixa",
          "variavel",
          "mista",
          "nao_informada"
        ],
        "title": "PrevisibilidadeRenda",
        "type": "string"
      },
      "Tipo": {
        "enum": [
          "corrente",
          "poupanca",
          "carteira",
          "reserva",
          "outra"
        ],
        "title": "Tipo",
        "type": "string"
      },
      "UsuariaOut": {
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "username": {
            "title": "Username",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username"
        ],
        "title": "UsuariaOut",
        "type": "object"
      }
    },
    "securitySchemes": {
      "SessionAuth": {
        "in": "cookie",
        "name": "sessionid",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "",
    "title": "Grupo 11 - API financeira",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
