  "paths": {
    "/api/auth/csrf": {
      "get": {
        "description": "Entrega o token CSRF exigido no login e nas demais escritas.",
        "operationId": "autenticacao_api_obter_csrf",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Obter Csrf",
        "tags": [
          "autenticação"
        ]
      }
    },
    "/api/auth/login": {
      "post": {
        "description": "Abre a sessão. A resposta não revela se o usuário existe.",
        "operationId": "autenticacao_api_entrar",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredenciaisIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuariaOut"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErroOut"
                }
              }
            },
            "description": "Unauthorized"
          }
        },
        "summary": "Entrar",
        "tags": [
          "autenticação"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "description": "Encerra a sessão atual e apaga seus dados no servidor.",
        "operationId": "autenticacao_api_sair",
        "parameters": [],
        "responses": {
          "204": {
            "description": "No Content"
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "summary": "Sair",
        "tags": [
          "autenticação"
        ]
      }
    },
    "/api/auth/me": {
      "get": {
        "description": "Retorna a usuária identificada pela sessão.",
        "operationId": "autenticacao_api_usuaria_atual",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuariaOut"
                }
              }
            },
            "description": "OK"
          }
        },
        "security": [
          {
            "SessionAuth": []
          }
        ],
        "summary": "Usuaria Atual",
        "tags": [
          "autenticação"
        ]
      }
    },
    "/api/categorias": {
      "get": {
        "description": "Lista somente as categorias da usuária autenticada.",
        "operationId": "financas_api_transacoes_listar_categorias",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CategoriaOut"
